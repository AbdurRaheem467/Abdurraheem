# DataFinder AI Configuration

# Server Port
PORT=3000

# Google Programmable Search / Custom Search API (Optional)
# If provided, DataFinder AI will fetch live results from Google Custom Search
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# SerpAPI Key (Optional fallback search engine API)
SERPAPI_KEY=

# Note: If no API keys are provided, DataFinder AI automatically operates in 
# Intelligent Engine mode, providing rich location-aware results for testing.
